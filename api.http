# devops-learning-path -- API scratchpad for the VS Code REST Client extension
#
# Click "Send Request" above any block. Run them top to bottom the first time:
# later requests reuse values captured from earlier responses (the token from
# `login`, the id from `createTask`, and so on), so those must have run at
# least once in this editor session.
#
# Re-running `registerAlice` after the first time returns 409 -- that is the
# duplicate-email guard doing its job, not a failure.

@baseUrl = https://devops-learning-path.vercel.app
@contentType = application/json

@aliceEmail = alice@example.com
@alicePassword = alice-password-123
@bobEmail = bob@example.com
@bobPassword = bob-password-123

# Captured from responses further down. REST Client resolves these lazily,
# so they fill in as soon as the request they name has been sent.
@access = {{login.response.body.$.access_token}}
@refresh = {{login.response.body.$.refresh_token}}
@auth = Authorization: Bearer {{access}}
@taskId = {{createTask.response.body.$.id}}


###############################################################################
# 1. HEALTH -- no auth needed
###############################################################################

### 1.1 Is the process up?
GET {{baseUrl}}/health

### 1.2 Can it reach Postgres? (runs a real SELECT 1)
GET {{baseUrl}}/health/db

### 1.3 Service root
GET {{baseUrl}}/


###############################################################################
# 2. AUTH -- register and log in
###############################################################################

### 2.1 Register Alice  -> 201 (409 if you have run this before)
# @name registerAlice
POST {{baseUrl}}/auth/register
Content-Type: {{contentType}}

{
  "email": "{{aliceEmail}}",
  "password": "{{alicePassword}}"
}

### 2.2 Log in  -> access_token (JWT, 30 min) + refresh_token (opaque, 30 days)
# NOTE: this endpoint takes form-encoded data, not JSON -- that is what the
# OAuth2 password flow specifies. The field is named `username`; put the
# email in it.
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/x-www-form-urlencoded

username={{aliceEmail}}&password={{alicePassword}}

### 2.3 Who am I?  -> the access token resolved to a user
GET {{baseUrl}}/auth/me
{{auth}}


###############################################################################
# 3. TASKS -- the CRUD. Every route requires a token.
###############################################################################

### 3.1 Create a task  -> 201
# `user_id` is NOT in the body. It comes from the token, so you cannot
# create a task owned by somebody else.
# @name createTask
POST {{baseUrl}}/tasks
Content-Type: {{contentType}}
{{auth}}

{
  "title": "write the runbook",
  "description": "document the deploy steps",
  "due_date": "2027-03-01"
}

### 3.2 Create a second one, so the filters below have something to chew on
POST {{baseUrl}}/tasks
Content-Type: {{contentType}}
{{auth}}

{
  "title": "rotate the JWT signing key",
  "due_date": "2027-01-15"
}

### 3.3 List my tasks (newest first)
GET {{baseUrl}}/tasks
{{auth}}

### 3.4 Only the unfinished ones
GET {{baseUrl}}/tasks?is_done=false
{{auth}}

### 3.5 Only ones due before a date
GET {{baseUrl}}/tasks?due_before=2027-02-01
{{auth}}

### 3.6 Pagination
GET {{baseUrl}}/tasks?limit=1&offset=0
{{auth}}

### 3.7 limit over 100 -> 422, the cap is enforced server-side
GET {{baseUrl}}/tasks?limit=999
{{auth}}

### 3.8 Read one task
GET {{baseUrl}}/tasks/{{taskId}}
{{auth}}

### 3.9 PATCH one field -- description and due_date survive untouched
PATCH {{baseUrl}}/tasks/{{taskId}}
Content-Type: {{contentType}}
{{auth}}

{
  "is_done": true
}

### 3.10 PATCH an explicit null -- this CLEARS due_date
# Omitting a field leaves it alone; sending null wipes it. That distinction
# is what `exclude_unset=True` buys in the router.
PATCH {{baseUrl}}/tasks/{{taskId}}
Content-Type: {{contentType}}
{{auth}}

{
  "due_date": null
}

### 3.11 Empty PATCH -> 400
PATCH {{baseUrl}}/tasks/{{taskId}}
Content-Type: {{contentType}}
{{auth}}

{}

### 3.12 Validation failures -> 422 (blank title)
POST {{baseUrl}}/tasks
Content-Type: {{contentType}}
{{auth}}

{
  "title": ""
}

### 3.13 Delete -> 204
DELETE {{baseUrl}}/tasks/{{taskId}}
{{auth}}

### 3.14 ...and it is gone -> 404
GET {{baseUrl}}/tasks/{{taskId}}
{{auth}}


###############################################################################
# 4. OWNERSHIP -- prove Bob cannot touch Alice's data
#
# Run 4.1 and 4.2 to get Bob a token, then 4.3-4.6. Every one should be 404,
# never 403: a 403 would confirm the row exists and let anyone enumerate ids.
#
# Re-run 3.1 first if you already deleted Alice's task in 3.13.
###############################################################################

### 4.1 Register Bob
POST {{baseUrl}}/auth/register
Content-Type: {{contentType}}

{
  "email": "{{bobEmail}}",
  "password": "{{bobPassword}}"
}

### 4.2 Log Bob in
# @name bobLogin
POST {{baseUrl}}/auth/login
Content-Type: application/x-www-form-urlencoded

username={{bobEmail}}&password={{bobPassword}}

### 4.3 Bob reads Alice's task -> 404
GET {{baseUrl}}/tasks/{{taskId}}
Authorization: Bearer {{bobLogin.response.body.$.access_token}}

### 4.4 Bob edits Alice's task -> 404
PATCH {{baseUrl}}/tasks/{{taskId}}
Content-Type: {{contentType}}
Authorization: Bearer {{bobLogin.response.body.$.access_token}}

{
  "title": "pwned"
}

### 4.5 Bob deletes Alice's task -> 404
DELETE {{baseUrl}}/tasks/{{taskId}}
Authorization: Bearer {{bobLogin.response.body.$.access_token}}

### 4.6 Bob's own list -> 200, empty. He cannot see Alice's rows at all.
GET {{baseUrl}}/tasks
Authorization: Bearer {{bobLogin.response.body.$.access_token}}


###############################################################################
# 5. TOKEN LIFECYCLE -- refresh, rotation, reuse detection
###############################################################################

### 5.1 Refresh -> a NEW access token AND a NEW refresh token
# The refresh token you sent is now dead. That is rotation.
# @name refreshOnce
POST {{baseUrl}}/auth/refresh
Content-Type: {{contentType}}

{
  "refresh_token": "{{refresh}}"
}

### 5.2 The new access token works
GET {{baseUrl}}/auth/me
Authorization: Bearer {{refreshOnce.response.body.$.access_token}}

### 5.3 REUSE DETECTION -- send the OLD refresh token again -> 401
# Two parties now hold the same token, and the server cannot tell the
# legitimate client from a thief. It assumes theft and revokes the whole
# token family, so 5.4 below fails too. Log in again (2.2) to recover.
POST {{baseUrl}}/auth/refresh
Content-Type: {{contentType}}

{
  "refresh_token": "{{refresh}}"
}

### 5.4 Even the rotated token is now dead -> 401 (whole family revoked)
POST {{baseUrl}}/auth/refresh
Content-Type: {{contentType}}

{
  "refresh_token": "{{refreshOnce.response.body.$.refresh_token}}"
}

### 5.5 Log out this device (revokes that refresh family) -> 204
# Re-run 2.2 first to get a live refresh token.
POST {{baseUrl}}/auth/logout
Content-Type: {{contentType}}

{
  "refresh_token": "{{refresh}}"
}

### 5.6 Log out everywhere (needs an access token) -> 204
POST {{baseUrl}}/auth/logout-all
{{auth}}


###############################################################################
# 6. NEGATIVE CASES -- what rejection looks like
###############################################################################

### 6.1 No token at all -> 401
GET {{baseUrl}}/tasks

### 6.2 Garbage token -> 401, generic message (no hint for an attacker)
GET {{baseUrl}}/auth/me
Authorization: Bearer not-a-real-token

### 6.3 Forged "alg: none" token -> 401
# An unsigned token. Works against any server that forgets to pin the
# algorithm list when verifying. Check the response: it is rejected.
GET {{baseUrl}}/auth/me
Authorization: Bearer eyJhbGciOiJub25lIiwidHlwIjoiSldUIn0.eyJzdWIiOiIxIiwiaXNzIjoiZGV2b3BzLWxlYXJuaW5nLWFwaSIsImF1ZCI6ImRldm9wcy1sZWFybmluZy1hcGkifQ.

### 6.4 Duplicate registration -> 409
POST {{baseUrl}}/auth/register
Content-Type: {{contentType}}

{
  "email": "{{aliceEmail}}",
  "password": "{{alicePassword}}"
}

### 6.5 Wrong password -> 401
# Same message as an unknown email, and the same response time, so this
# cannot be used to discover which addresses are registered.
POST {{baseUrl}}/auth/login
Content-Type: application/x-www-form-urlencoded

username={{aliceEmail}}&password=definitely-wrong

### 6.6 Unknown email -> 401, identical response
POST {{baseUrl}}/auth/login
Content-Type: application/x-www-form-urlencoded

username=nobody@example.com&password=definitely-wrong
